# Image de TEST : image d'exécution officielle Odoo 19.0 (figée par commit, voir repos.yaml)
# + dépendances Python supplémentaires listées dans requirements-extra.txt.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY requirements-extra.txt /tmp/requirements-extra.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements-extra.txt \
    && pip3 freeze > /opt/fayadort-pip-freeze.txt
ENV PYTHONDONTWRITEBYTECODE=1
USER odoo
